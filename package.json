{
  "name": "pi-ming-image",
  "version": "0.2.0",
  "description": "Pi package exposing Ming image generation and layer decomposition on OpenRouter, with a bundled visual-design skill.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chasen-Liao/pi-ming-image.git"
  },
  "files": [
    "extensions/",
    "lib/",
    "skills/ling-ui-design/SKILL.md",
    "skills/ling-ui-design/LICENSE",
    "skills/ling-ui-design/README.md",
    "skills/ling-ui-design/pyproject.toml",
    "skills/ling-ui-design/pyrightconfig.json",
    "skills/ling-ui-design/.env.example",
    "skills/ling-ui-design/references/",
    "skills/ling-ui-design/scripts/",
    "skills/image-to-editable-ppt/"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/ling-ui-design",
      "./skills/image-to-editable-ppt"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
